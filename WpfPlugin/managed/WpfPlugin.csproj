<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WPF 플러그인의 **관리 코드** 쪽.

    NativeAOT 로는 WPF 를 못 쓴다. 그래서 네이티브 새시(WpfBridgePlugin)가 .NET 런타임을
    띄우고 이 어셈블리를 불러들인다. AutoCAD 의 acmgd.dll 이 하는 일과 같다.

    net8.0-windows + UseWPF — 창을 띄우려면 WindowsDesktop 런타임이 필요하다.
    EnableDynamicLoading 이 핵심: 이걸 켜야 .runtimeconfig.json 이 나오고,
    hostfxr 가 그 파일을 읽어 어떤 런타임으로 올릴지 판단한다. 없으면 로드가 실패한다.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <!-- [UnmanagedCallersOnly] 로 네이티브에 함수 포인터를 넘기려면 필요하다. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>WpfPlugin</AssemblyName>
    <RootNamespace>WpfPlugin</RootNamespace>
  </PropertyGroup>

</Project>
