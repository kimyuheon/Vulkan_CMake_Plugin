{
    // F5 → 플러그인을 짓고 설치한 뒤 **엔진**을 띄운다.
    //
    // 플러그인은 실행 파일이 아니라 .dylib 이라 혼자 못 뜬다. WallDialogPlugin/WpfPlugin 이
    // vcxproj 의 "디버깅 명령" 에 엔진 exe 를 걸어 두는 것과 같은 얼개다 — 디버기는 엔진이고,
    // 플러그인은 엔진이 dlopen 할 때 붙는다.
    //
    // 필요한 확장: CodeLLDB (vadimcn.vscode-lldb)
    //
    // ⚠️ 브레이크포인트는 로드 **전에** 걸어도 된다. 아직 없는 모듈이라 "pending" 으로
    //    남았다가 엔진이 dlopen 하는 순간 풀린다(실측: PluginManager::load → CAD_PluginLoad
    //    → pluginLoad 로 스택이 이어지고, id 와 Swift 전역이 그대로 읽힌다).
    // ⚠️ C 심볼(CAD_PluginLoad)에 직접 걸면 줄이 안 나온다 — @_cdecl 이 만드는 건 썽크다.
    //    Swift 소스에 줄 브레이크포인트를 찍거나 pluginLoad 로 잡는다.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "엔진 띄우고 SwiftPlugin 디버그",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/../3dEngine/build/VulkanApp",
            "cwd": "${workspaceFolder}/../3dEngine/build",
            "args": [],
            "preLaunchTask": "SwiftPlugin 빌드+설치"
        }
    ]
}
